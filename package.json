{
  "name": "typeshift-docs",
  "private": true,
  "type": "module",
  "scripts": {
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:lint": "markdownlint-cli2 && node docs/.vitepress/lint.mjs",
    "docs:snippets": "node docs/.vitepress/snippets.mjs",
    "docs:snippets:check": "node docs/.vitepress/snippets.mjs --check",
    "docs:check": "npm run docs:snippets:check && npm run docs:lint && npm run docs:build"
  },
  "devDependencies": {
    "markdownlint-cli2": "0.24.1",
    "mermaid": "11.17.2",
    "vitepress": "1.6.4",
    "vitepress-plugin-llms": "1.15.0",
    "vitepress-plugin-mermaid": "2.0.17",
    "yaml": "2.9.1"
  }
}
