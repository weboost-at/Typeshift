<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <PackageId>Agentic</PackageId>
    <Description>Code-defined agents and toolsets for Microsoft.Extensions.AI. A source generator turns toolsets and agents into reflection-free AIFunctions, typed allowlisted settings and one AddAgentic() registration.</Description>
    <PackageTags>ai;agents;tools;source-generator;microsoft.extensions.ai;llm</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Agentic.Generators/Agentic.Generators.csproj" ReferenceOutputAssembly="false" />
    <None Include="../Agentic.Generators/bin/$(Configuration)/netstandard2.0/Agentic.Generators.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="buildTransitive/Agentic.props" Pack="true" PackagePath="buildTransitive" />
    <None Include="../../README.md" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Agentic.Tests" />
  </ItemGroup>

</Project>
