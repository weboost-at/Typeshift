<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <!-- D38: the library's name; docs/contributing/renaming.md lists everywhere it appears -->
    <PackageId>Typeshift</PackageId>
    <Description>Code-defined agents and toolsets for Microsoft.Extensions.AI. A source generator turns them into reflection-free AIFunctions, a typed settings record per agent and one AddTypeshift() registration, ready for Native AOT.</Description>
    <PackageTags>ai;agents;tools;source-generator;microsoft.extensions.ai;llm;aot</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>https://github.com/weboost-at/Typeshift/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Typeshift.Generators/Typeshift.Generators.csproj" ReferenceOutputAssembly="false" />
    <None Include="../Typeshift.Generators/bin/$(Configuration)/netstandard2.0/Typeshift.Generators.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <!-- D38: NuGet imports buildTransitive/{PackageId}.props only, so the file is packed under the package's ID -->
    <None Include="buildTransitive/Typeshift.props" Pack="true" PackagePath="buildTransitive/$(PackageId).props" />
    <None Include="PACKAGE.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Typeshift.Tests" />
  </ItemGroup>

</Project>
