<Project>

  <!-- D68: tools take their descriptions from XML docs, so a project that does not choose gets them. This file is
       imported before the project's own properties, so the capital T marks the value as the package's: a project
       that chooses for itself writes over it, and Typeshift.targets acts only while it stands. -->
  <PropertyGroup Condition="'$(GenerateDocumentationFile)' == ''">
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <!-- The generator intercepts services.AddTypeshift() from this namespace. -->
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Typeshift.Generated</InterceptorsNamespaces>
    <!-- D55: the XML docs of the types tools take describe their schemas; false leaves them out. -->
    <TypeshiftSchemaAnnotations Condition="'$(TypeshiftSchemaAnnotations)' == ''">true</TypeshiftSchemaAnnotations>
  </PropertyGroup>

  <ItemGroup>
    <!-- D45: TSH027 holds for projects that publish with Native AOT or declare themselves compatible -->
    <CompilerVisibleProperty Include="PublishAot" />
    <CompilerVisibleProperty Include="IsAotCompatible" />
  </ItemGroup>

  <!-- D55: Weboost.SchemaAnnotations collects docs for a class marked in source, so each project gets one, named after
       its assembly so that a reference granting InternalsVisibleTo never brings a second of the same name. -->
  <Target Name="TypeshiftSchemaAnnotations"
          BeforeTargets="CoreCompile"
          Condition="'$(TypeshiftSchemaAnnotations)' == 'true' and '$(GenerateDocumentationFile)' == 'true' and '$(Language)' == 'C#'">
    <PropertyGroup>
      <_TypeshiftAnnotationsClass>TypeshiftSchemaAnnotations_$([System.Text.RegularExpressions.Regex]::Replace('$(AssemblyName)', '[^A-Za-z0-9_]', '_'))</_TypeshiftAnnotationsClass>
      <_TypeshiftAnnotationsFile>$(IntermediateOutputPath)$(AssemblyName).TypeshiftSchemaAnnotations.g.cs</_TypeshiftAnnotationsFile>
    </PropertyGroup>

    <WriteLinesToFile File="$(_TypeshiftAnnotationsFile)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true"
                      Lines="// &lt;auto-generated/&gt;;[global::Weboost.SchemaAnnotations.SchemaAnnotations(IncludeInternal = true)];[global::System.ComponentModel.EditorBrowsable(global::System.ComponentModel.EditorBrowsableState.Never)];internal static partial class $(_TypeshiftAnnotationsClass);{;}" />

    <ItemGroup>
      <Compile Include="$(_TypeshiftAnnotationsFile)" />
      <FileWrites Include="$(_TypeshiftAnnotationsFile)" />
    </ItemGroup>
  </Target>

</Project>
