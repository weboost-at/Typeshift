<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="../../build/UseGenerator.props" />

  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Typeshift.Tests.Testing.Assertions" />
    <Using Include="Typeshift.Tests.Testing.Bases" />
    <Using Include="Typeshift.Tests.Testing.Data" />
    <!-- Deterministic CI builds map [CallerFilePath] to /_/..., so the convention tests read the directory from here. -->
    <AssemblyMetadata Include="TestsDirectory" Value="$(MSBuildProjectDirectory)/.." />
  </ItemGroup>

  <!-- D61: C# 15's union types need .NET 11, so the union tests and their types build for net11.0 only -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <Compile Remove="**/Union*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Typeshift.Tests.Toolsets/Typeshift.Tests.Toolsets.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Bogus" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Newtonsoft.Json" />
  </ItemGroup>

</Project>
