<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!-- A folder of its own, so a package repacked under the same version is never served from a stale cache. -->
  <config>
    <add key="globalPackagesFolder" value="../../artifacts/consumer-packages" />
  </config>

  <packageSources>
    <clear />
    <add key="local" value="../../artifacts/packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="local">
      <package pattern="Agentic" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

</configuration>
