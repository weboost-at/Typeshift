<Project Sdk="Microsoft.NET.Sdk">

  <!-- The code the documentation shows. mdsnippets copies the marked regions into the Markdown, the build compiles
       them, and CI runs the program, so no snippet drifts from the API. -->
  <Import Project="../../build/UseGenerator.props" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Typeshift.Samples.Docs</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Examples/*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
