<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    A folder of its own keeps local packs out of the machine's package cache. NuGet reuses what it restored here, even
    a version repacked since, so delete artifacts/consumer-packages before running again after a repack.
  -->
  <config>
    <add key="globalPackagesFolder" value="../../artifacts/consumer-packages" />
  </config>

  <packageSources>
    <clear />
    <add key="local" value="../../artifacts/packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="local">
      <package pattern="Typeshift" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

</configuration>
