<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="../../build/UseGenerator.props" />

  <!-- begin-snippet: aot-project -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <!-- end-snippet -->

  <PropertyGroup>
    <RootNamespace>Typeshift.Samples</RootNamespace>
  </PropertyGroup>

  <!-- An enum, so the Native AOT build covers a provider id type other than string -->
  <!-- begin-snippet: provider-id-type -->
  <PropertyGroup>
    <TypeshiftProviderIdType>Typeshift.Samples.Chat.Provider</TypeshiftProviderIdType>
  </PropertyGroup>
  <!-- end-snippet -->

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

</Project>
