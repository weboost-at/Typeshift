<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="../../build/UseGenerator.props" />

  <!-- begin-snippet: aot-project -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <!-- end-snippet -->

  <!-- CI publishes the sample a second time with -p:TrimmedOnly=true: trimmed and not as Native AOT, where JSON
       reflection is off as well. PublishTrimmed on the command line would reach the generator's project too -->
  <PropertyGroup Condition="'$(TrimmedOnly)' == 'true'">
    <PublishAot>false</PublishAot>
    <PublishTrimmed>true</PublishTrimmed>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <RootNamespace>Typeshift.Samples</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

</Project>
