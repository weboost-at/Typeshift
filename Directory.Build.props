<Project>

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <IsPackable>false</IsPackable>
    <Authors>Maximilian Hollnbuchner</Authors>
    <Company>weboost.at</Company>
    <Copyright>Copyright (c) 2026 Maximilian Hollnbuchner</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://weboost-at.github.io/Typeshift/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/weboost-at/Typeshift</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <!-- Versions come from git tags (v1.2.3) via MinVer; untagged builds are 0.1.0-alpha.0.N. -->
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerMinimumMajorMinor>0.1</MinVerMinimumMajorMinor>
    <MinVerDefaultPreReleaseIdentifiers>alpha.0</MinVerDefaultPreReleaseIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" PrivateAssets="all" />
  </ItemGroup>

  <!-- The code style of AGENTS.md as far as the build can hold it, for src, samples and tests. The demos are apps
       of their own outside CI, where a failing guard would go unseen. -->
  <PropertyGroup>
    <PathFromRepository>$([MSBuild]::MakeRelative('$(MSBuildThisFileDirectory)', '$(MSBuildProjectDirectory)').Replace('\', '/'))</PathFromRepository>
    <HoldsCodeStyle>true</HoldsCodeStyle>
    <HoldsCodeStyle Condition="$(PathFromRepository.StartsWith('demos/'))">false</HoldsCodeStyle>
  </PropertyGroup>

  <!-- The style rules .editorconfig sets to warning: an error with TreatWarningsAsErrors. -->
  <PropertyGroup Condition="'$(HoldsCodeStyle)' == 'true'">
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!-- "Never read the clock" by symbol (RS0030). A sample is an app, so it may name the system clock where it
       composes its services. The package is used at build time alone and adds nothing to Typeshift. -->
  <ItemGroup Condition="'$(HoldsCodeStyle)' == 'true'">
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.txt" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.Library.txt" Condition="!$(PathFromRepository.StartsWith('samples/'))" />
  </ItemGroup>

</Project>
