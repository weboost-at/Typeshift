<Project>

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <IsPackable>false</IsPackable>
    <Authors>Maximilian Hollnbuchner</Authors>
    <Company>weboost.at</Company>
    <Copyright>Copyright (c) 2026 Maximilian Hollnbuchner</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://weboost-at.github.io/Typeshift/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/weboost-at/Typeshift</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <!-- Versions come from git tags (v1.2.3) via MinVer; untagged builds are 0.1.0-alpha.0.N. -->
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerMinimumMajorMinor>0.1</MinVerMinimumMajorMinor>
    <MinVerDefaultPreReleaseIdentifiers>alpha.0</MinVerDefaultPreReleaseIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" PrivateAssets="all" />
  </ItemGroup>

  <!-- "Never read the clock" by symbol (RS0030, an error with TreatWarningsAsErrors), for the code the style of
       AGENTS.md covers: the demos are apps of their own. A sample is an app as well, so it may name the system
       clock where it composes its services. The package is used at build time alone and adds nothing to Typeshift. -->
  <PropertyGroup>
    <PathFromRepository>$([MSBuild]::MakeRelative('$(MSBuildThisFileDirectory)', '$(MSBuildProjectDirectory)').Replace('\', '/'))</PathFromRepository>
  </PropertyGroup>

  <ItemGroup Condition="!$(PathFromRepository.StartsWith('demos/'))">
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.txt" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.Library.txt" Condition="!$(PathFromRepository.StartsWith('samples/'))" />
  </ItemGroup>

</Project>
