<Project Sdk="Microsoft.NET.Sdk">

  <!-- What every demo needs from a host: user-defined providers, a store on disk, a scripted model, console spans.
       It declares no toolsets or agents, so it needs no generator and no id type. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Typeshift.Demos</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Typeshift/Typeshift.csproj" />
    <PackageReference Include="Anthropic" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

</Project>
