<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="../../build/UseGenerator.props" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Typeshift.Demos.Support</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Typeshift.Demos.Shared/Typeshift.Demos.Shared.csproj" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../Typeshift.Demos.MultiProvider/providers.json" Link="providers.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
